import os
import csv
import pefile

def is_pe_file(path: str) -> bool:
    """
    Return True if 'path' is a valid PE (Portable Executable) file.
    """
    try:
        pefile.PE(path)
        return True
    except:
        return False

# ─── Configuration ─────────────────────────────────────────────────────────────
BASE_DIR    = r"C:\samples"                   # top‐level folder containing 'malware' and 'benign'
OUT_MANIFEST = r"C:\samples\manifest.csv"     # where to write your manifest
# ───────────────────────────────────────────────────────────────────────────────

with open(OUT_MANIFEST, "w", newline="") as csvf:
    writer = csv.writer(csvf)
    # header row
    writer.writerow(["Filename", "FullPath", "Label", "Malware_Class"])

    for label in ("malware", "benign"):
        root_path = os.path.join(BASE_DIR, label)
        for dirpath, _, files in os.walk(root_path):
            # for benign samples we'll just tag the class as "Benign"
            mal_class = os.path.basename(dirpath) if label == "malware" else "Benign"

            for fname in files:
                full_path = os.path.join(dirpath, fname)
                if not is_pe_file(full_path):
                    continue
                writer.writerow([fname, full_path, label, mal_class])

print(f"[✔] Manifest generated at {OUT_MANIFEST}")



import os
import pefile
import pandas as pd
import math

# calculate Shannon entropy of a block of data
def calc_entropy(data: bytes) -> float:
    if not data:
        return 0.0
    counts = [data.count(bytes([i])) for i in range(256)]
    probs  = [c/len(data) for c in counts if c]
    return -sum(p * math.log2(p) for p in probs)

# load your manifest
df = pd.read_csv(r"C:\samples\manifest.csv")

features = []
for _, row in df.iterrows():
    path      = row.FullPath
    label     = row.Label
    mclass    = row.Malware_Class
    try:
        pe = pefile.PE(path)
    except (pefile.PEFormatError, FileNotFoundError):
        continue   # skip non-PE or missing files

    # --- SECTION FEATURES ---
    secs       = pe.sections
    num_sec    = len(secs)
    non_std   = 0
    mismatch  = 0
    entropies = []

    std_names = {".text", ".data", ".rdata", ".rsrc", ".idata", ".pdata"}
    for s in secs:
        name = s.Name.decode(errors="ignore").strip("\x00").lower()
        if name not in std_names:
            non_std += 1
        if s.Misc_VirtualSize != s.SizeOfRawData:
            mismatch += 1
        data = s.get_data()
        ent  = calc_entropy(data)
        entropies.append(ent)

    avg_ent  = round(sum(entropies)/num_sec, 3) if num_sec else 0.0
    packed   = int(any(e > 7.0 for e in entropies))

    # --- IMPORT FEATURES ---
    dlls = []
    apis = []
    if hasattr(pe, "DIRECTORY_ENTRY_IMPORT"):
        for entry in pe.DIRECTORY_ENTRY_IMPORT:
            dlls.append(entry.dll.decode(errors="ignore"))
            for imp in entry.imports:
                if imp.name:
                    apis.append(imp.name.decode(errors="ignore"))

    unique_dlls = sorted(set(dlls))
    unique_apis = sorted(set(apis))

    features.append({
        "Sample":            row.Filename,
        "FullPath":          path,
        "Label":             label,
        "Malware_Class":     mclass,
        "Num_Sections":      num_sec,
        "Non_Standard_Sections": non_std,
        "Size_Mismatch_Count":   mismatch,
        "Avg_Entropy":           avg_ent,
        "Packed":                packed,
        "Num_Imported_DLLs":     len(unique_dlls),
        "Num_Imported_APIs":     len(unique_apis),
        "DLLs":                  ",".join(unique_dlls),
        "APIs":                  ",".join(unique_apis),
    })

# write out your full feature matrix
out_df = pd.DataFrame(features)
out_df.to_csv("static_feature_matrix.csv", index=False)
print(f"[✔] Extracted {len(out_df)} PE files with full static features.")

