import os
import pefile

def is_pe_file(file_path):
    try:
        pefile.PE(file_path)
        return True
    except:
        return False

def count_pe_files(base_dir):
    count = 0
    for root, _, files in os.walk(base_dir):
        for file in files:
            file_path = os.path.join(root, file)
            if is_pe_file(file_path):
                count += 1
    return count

# 🔧 Change this to your malware folder path
directory = r"C:\samples\malware"
total = count_pe_files(directory)

print(f"[✔] Total PE files in {directory}: {total}")





import csv
import os
import re
import subprocess
import logging

# ─── Config ────────────────────────────────────────────────────────────────────
MANIFEST_CSV = r"C:\samples\manifest.csv"
OUTPUT_CSV   = r"C:\samples\dynamic_features.csv"
ERROR_LOG    = r"C:\samples\errors.log"

APIMINER_EXE = r"C:\Tools\APIMiner\bin\APIMiner.exe"
MONITOR_DLL  = r"C:\Tools\APIMiner\bin\apiminer-monitor-x86.dll"
TIMEOUT_SECS = 300

logging.basicConfig(filename=ERROR_LOG, level=logging.ERROR,
                    format='%(asctime)s %(levelname)s: %(message)s')

def parse_apis(text):
    apis = set()
    for line in text.splitlines():
        m = re.match(r'^\s*([A-Za-z0-9_]+)\(', line)
        if m:
            apis.add(m.group(1))
    return sorted(apis)

# Ensure output CSV has header
if not os.path.exists(OUTPUT_CSV):
    with open(OUTPUT_CSV, 'w', newline='') as outf:
        csv.writer(outf).writerow(
            ["Sample","FullPath","Label","Malware_Class","Called_APIs"]
        )

# Open manifest and output in one go
with open(MANIFEST_CSV, newline='') as mf, \
     open(OUTPUT_CSV, 'a', newline='') as outf:

    reader = csv.DictReader(mf)
    writer = csv.writer(outf)

    for idx, row in enumerate(reader, 1):
        sample = row["Sample"]
        path   = row["FullPath"]
        label  = row["Label"]
        mclass = row["Malware_Class"]

        print(f"[{idx}/{reader.line_num}] Processing {sample}")
        cmd = [APIMINER_EXE, "--app", path, "--dll", MONITOR_DLL]
        try:
            proc = subprocess.run(
                cmd, capture_output=True, text=True, timeout=TIMEOUT_SECS
            )
            apis = parse_apis(proc.stdout)
            writer.writerow([
                sample, path, label, mclass, ";".join(apis)
            ])
        except subprocess.TimeoutExpired:
            msg = f"Timeout on {sample}"
            print(msg); logging.error(msg)
        except Exception as e:
            msg = f"Error on {sample}: {e}"
            print(msg); logging.error(msg)

print("[✔] Done extracting dynamic APIs.")


