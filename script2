import pandas as pd

# 📂 Path to your DoS conn.log
dos_conn_log = "./captures/dos/conn.log"

# 📂 Output CSV file
output_csv = "dos_conn.csv"

# 📥 Read conn.log
df = pd.read_csv(
    dos_conn_log,
    sep="\t",          # Zeek logs are tab-separated
    comment="#",       # Ignore comments starting with #
    na_values="-",     # Treat '-' as NaN (missing value)
    low_memory=False
)

# 💾 Save to CSV
df.to_csv(output_csv, index=False)

print(f"✅ Successfully converted DoS conn.log to {output_csv}")
